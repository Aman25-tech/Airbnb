<% layout('layouts/boilerplate.ejs') %>

    <script>
        const mapToken = "<%= process.env.MAP_TOKEN %>";
    </script>

    <div class="container mt-5 mb-5">
        <div class="row">
            <div class="col-lg-8 offset-lg-2">
                <!-- Title -->
                <h2 class="section-heading mb-4" style="font-size: 1.75rem;">
                    <%= listing.title %>
                </h2>

                <!-- Main Image -->
                <div style="overflow: hidden; border-radius: var(--radius-2xl); position: relative;">
                    <img class="show-img" src="<%= listing.image.url%>" alt="<%= listing.title %>">
                    <div style="position: absolute; bottom: var(--space-4); right: var(--space-4); z-index: 2;">
                        <div class="price-badge">
                            <span class="show-price" style="font-size: 1.5rem;">&#8377;<%=
                                    listing.price.toLocaleString('en-IN') %></span>
                            <span style="color: var(--color-gray-400); font-size: 0.875rem;">/night</span>
                        </div>
                    </div>
                </div>

                <!-- Info Card -->
                <div class="card show-card mt-5">
                    <div class="card-body">
                        <div class="show-info-row">
                            <i class="fa-solid fa-circle-user"
                                style="background: var(--color-rose-100); color: var(--color-primary);"></i>
                            <div>
                                <p class="mb-0" style="font-weight: 700; color: var(--color-gray-900);">Hosted by <%=
                                        listing.owner.username %>
                                </p>
                                <p class="mb-0" style="font-size: 0.8rem; color: var(--color-gray-400);">Superhost</p>
                            </div>
                        </div>

                        <div class="show-info-row">
                            <i class="fa-solid fa-align-left"
                                style="background: var(--color-indigo-50); color: var(--color-info);"></i>
                            <p class="mb-0 text-muted" style="line-height: 1.7;">
                                <%= listing.description %>
                            </p>
                        </div>

                        <div class="show-info-row">
                            <i class="fa-solid fa-location-dot"
                                style="background: rgba(239, 68, 68, 0.08); color: var(--color-danger);"></i>
                            <p class="mb-0"><strong>
                                    <%= listing.location %>
                                </strong>, <%= listing.country %>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
                    <div class="btns mt-4">
                        <a href="/listings/<%= listing.id %>/edit" class="btn btn-dark px-4"
                            style="border-radius: var(--radius-lg); font-weight: 700; font-size: 0.875rem;">
                            <i class="fa-solid fa-pen-to-square me-2"></i>Edit Listing
                        </a>
                        <form method="post" action="/listings/<%= listing.id %>?_method=DELETE">
                            <button class="btn btn-outline-danger px-4"
                                style="border-radius: var(--radius-lg); font-weight: 700; font-size: 0.875rem;">
                                <i class="fa-solid fa-trash me-2"></i>Delete
                            </button>
                        </form>
                    </div>
                    <% } %>

                        <!-- Review Form -->
                        <% if(currUser) { %>
                            <hr class="my-5" style="border-color: var(--color-gray-200);">
                            <form method="post" action="/listings/<%= listing.id %>/reviews"
                                class="review-form needs-validation" novalidate>
                                <h4 class="mb-1" style="font-weight: 800; letter-spacing: -0.01em;">Leave a Review</h4>
                                <p class="text-muted mb-4" style="font-size: 0.875rem;">Share your experience and help
                                    other travelers</p>
                                <fieldset class="starability-basic mb-4">
                                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />&nbsp;&nbsp;
                                    <label for="first-rate1" title="Terrible">1 star</label>&nbsp;
                                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />&nbsp;&nbsp;
                                    <label for="first-rate2" title="Not good">2 stars</label>&nbsp;
                                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />&nbsp;&nbsp;
                                    <label for="first-rate3" title="Average">3 stars</label>&nbsp;
                                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />&nbsp;&nbsp;
                                    <label for="first-rate4" title="Very good">4 stars</label>&nbsp;
                                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />&nbsp;&nbsp;
                                    <label for="first-rate5" title="Amazing">5 stars</label>&nbsp;
                                </fieldset>
                                <div class="mb-4">
                                    <label for="comment" class="form-label">Your Experience</label>
                                    <textarea name="review[comment]" id="comment" rows="4" class="form-control" required
                                        placeholder="What made your stay special? Share details..."></textarea>
                                    <div class="invalid-feedback">Please share your experience</div>
                                </div>
                                <button class="btn btn-dark px-4"
                                    style="border-radius: var(--radius-lg); font-weight: 700;">
                                    <i class="fa-solid fa-paper-plane me-2"></i>Submit Review
                                </button>
                            </form>
                            <% } %>

                                <!-- Reviews -->
                                <% if(listing.reviews.length> 0) { %>
                                    <hr class="my-5" style="border-color: var(--color-gray-200);">
                                    <h4 class="section-heading mb-4" style="font-size: 1.25rem;">
                                        <i class="fa-solid fa-star me-2"
                                            style="color: var(--color-warning); font-size: 1rem;"></i>
                                        <%= listing.reviews.length %> Review<%= listing.reviews.length> 1 ? 's' : '' %>
                                    </h4>
                                    <div class="row g-3">
                                        <% for(review of listing.reviews){ %>
                                            <div class="col-md-6">
                                                <div class="card review-card h-100">
                                                    <div class="card-body p-4">
                                                        <div
                                                            class="d-flex justify-content-between align-items-center mb-3">
                                                            <div class="d-flex align-items-center gap-3">
                                                                <div
                                                                    style="width: 36px; height: 36px; border-radius: var(--radius-lg); background: linear-gradient(135deg, var(--color-primary-ghost), var(--color-rose-100)); display: flex; align-items: center; justify-content: center;">
                                                                    <i class="fa-solid fa-user"
                                                                        style="font-size: 0.75rem; color: var(--color-primary);"></i>
                                                                </div>
                                                                <div>
                                                                    <p class="starability-result mb-0"
                                                                        data-rating="<%= review.rating %>">
                                                                        <%= review.rating %> stars
                                                                    </p>
                                                                </div>
                                                            </div>
                                                            <% if(currUser && ( (review.author &&
                                                                review.author._id.equals(currUser._id)) ||
                                                                (listing.owner._id.equals(currUser._id)) )) { %>
                                                                <form
                                                                    action="/listings/<%= listing.id %>/reviews/<%= review.id %>?_method=DELETE"
                                                                    method="post" class="d-inline">
                                                                    <button class="btn btn-sm btn-outline-danger"
                                                                        title="Delete Review"
                                                                        style="border-radius: var(--radius-md); font-size: 0.7rem; padding: 0.25rem 0.5rem;"
                                                                        onclick="return confirm('Delete this review?')">
                                                                        <i class="fa-solid fa-trash"></i>
                                                                    </button>
                                                                </form>
                                                                <% } %>
                                                        </div>
                                                        <p class="card-text mb-0"
                                                            style="font-size: 0.9rem; line-height: 1.7; color: var(--color-gray-600); font-style: italic;">
                                                            "<%= review.comment %>"
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                            <% } %>
                                    </div>
                                    <% } %>

                                        <!-- Map -->
                                        <hr class="my-5" style="border-color: var(--color-gray-200);">
                                        <h4 class="section-heading mb-2" style="font-size: 1.25rem;">
                                            <i class="fa-solid fa-map-location-dot me-2"
                                                style="color: var(--color-info); font-size: 1rem;"></i>
                                            Where you'll be
                                        </h4>
                                        <p class="text-muted mb-3" style="font-size: 0.875rem;">
                                            <%= listing.location %>, <%= listing.country %>
                                        </p>
                                        <div id="map"></div>
            </div>
        </div>
    </div>

    <script src="/js/map.js"></script>