<% layout("/layouts/boilerplate") %>

    <!-- Hero Section -->
    <div class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <h1 class="hero-title">
                        Find your next<br>
                        <span class="highlight">perfect stay.</span>
                    </h1>
                    <p class="hero-subtitle">Discover unique homes, experiences, and places around the world — curated
                        just for you.</p>
                    <div class="hero-stats">
                        <div class="hero-stat">
                            <div class="hero-stat-number">
                                <%= allListings.length %>+
                            </div>
                            <div class="hero-stat-label">Listings</div>
                        </div>
                        <div class="hero-stat">
                            <div class="hero-stat-number">50+</div>
                            <div class="hero-stat-label">Countries</div>
                        </div>
                        <div class="hero-stat">
                            <div class="hero-stat-number">10K+</div>
                            <div class="hero-stat-label">Happy Guests</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container mt-0">
        <div id="filters">
            <a href="/listings" class="filter <%= activeCategory === 'Trending' ? 'active' : '' %>">
                <div><i class="fa-solid fa-fire"></i></div>
                <p>Trending</p>
            </a>
            <a href="/listings?category=Rooms" class="filter <%= activeCategory === 'Rooms' ? 'active' : '' %>">
                <div><i class="fa-solid fa-bed"></i></div>
                <p>Rooms</p>
            </a>
            <a href="/listings?category=Iconic Cities"
                class="filter <%= activeCategory === 'Iconic Cities' ? 'active' : '' %>">
                <div><i class="fa-solid fa-city"></i></div>
                <p>Iconic Cities</p>
            </a>
            <a href="/listings?category=Mountains" class="filter <%= activeCategory === 'Mountains' ? 'active' : '' %>">
                <div><i class="fa-solid fa-mountain"></i></div>
                <p>Mountains</p>
            </a>
            <a href="/listings?category=Castles" class="filter <%= activeCategory === 'Castles' ? 'active' : '' %>">
                <div><i class="fa-solid fa-chess-rook"></i></div>
                <p>Castles</p>
            </a>
            <a href="/listings?category=Arctic" class="filter <%= activeCategory === 'Arctic' ? 'active' : '' %>">
                <div><i class="fa-solid fa-snowflake"></i></div>
                <p>Arctic</p>
            </a>
            <a href="/listings?category=Camping" class="filter <%= activeCategory === 'Camping' ? 'active' : '' %>">
                <div><i class="fa-solid fa-campground"></i></div>
                <p>Camping</p>
            </a>
            <a href="/listings?category=Farms" class="filter <%= activeCategory === 'Farms' ? 'active' : '' %>">
                <div><i class="fa-solid fa-tractor"></i></div>
                <p>Farms</p>
            </a>
            <a href="/listings?category=Beaches" class="filter <%= activeCategory === 'Beaches' ? 'active' : '' %>">
                <div><i class="fa-solid fa-umbrella-beach"></i></div>
                <p>Beaches</p>
            </a>
            <a href="/listings?category=Domes" class="filter <%= activeCategory === 'Domes' ? 'active' : '' %>">
                <div><i class="fa-solid fa-landmark-dome"></i></div>
                <p>Domes</p>
            </a>
            <a href="/listings?category=Boats" class="filter <%= activeCategory === 'Boats' ? 'active' : '' %>">
                <div><i class="fa-solid fa-sailboat"></i></div>
                <p>Boats</p>
            </a>
            <div class="tax-toggle">
                <div class="form-check-reverse form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                    <label class="form-check-label" for="switchCheckDefault"
                        style="font-size: 0.8rem; white-space: nowrap;">Display total after taxes</label>
                </div>
            </div>
        </div>

        <% if (searchQuery) { %>
            <div class="search-results-info"
                style="padding: var(--space-4) 0; font-size: var(--font-size-base); color: var(--color-gray-500);">
                Showing results for "<strong style="color: var(--color-gray-800);">
                    <%= searchQuery %>
                </strong>"
                &mdash; <strong>
                    <%= allListings.length %>
                </strong> listing<%= allListings.length !==1 ? 's' : '' %> found
                    <a href="/listings"
                        style="margin-left: var(--space-4); color: var(--color-primary); text-decoration: none; font-weight: 600;">Clear
                        search</a>
            </div>
            <% } %>

                <% if (allListings.length===0) { %>
                    <div style="text-align: center; padding: var(--space-16) 0;">
                        <i class="fa-solid fa-magnifying-glass"
                            style="font-size: 3rem; color: var(--color-gray-300); margin-bottom: var(--space-4); display: block;"></i>
                        <h3 style="font-weight: 700; color: var(--color-gray-700); margin-bottom: var(--space-2);">No
                            listings found</h3>
                        <p style="color: var(--color-gray-400); max-width: 400px; margin: 0 auto;">Try a different
                            search term or browse another category.</p>
                        <a href="/listings"
                            style="display: inline-block; margin-top: var(--space-6); background: var(--color-primary); color: white; padding: 0.6rem 1.5rem; border-radius: var(--radius-full); text-decoration: none; font-weight: 600;">Browse
                            all</a>
                    </div>
                    <% } else { %>

                        <div class="row mt-4 g-4">
                            <% for (let i=0; i < allListings.length; i++) { let listing=allListings[i]; %>
                                <div class="col-lg-4 col-md-6 col-sm-12">
                                    <a href="/listings/<%= listing._id %>" class="listing-link">
                                        <div class="card listing-card" style="animation-delay: <%= i * 0.06 %>s;">
                                            <div class="card-img-wrapper">
                                                <img src="<%= listing.image.url %>" class="card-img-top"
                                                    alt="<%= listing.title %>" loading="lazy">
                                                <button class="card-wishlist"
                                                    onclick="event.preventDefault(); this.querySelector('i').classList.toggle('fa-solid'); this.querySelector('i').classList.toggle('fa-regular');"
                                                    title="Save to wishlist">
                                                    <i class="fa-regular fa-heart"></i>
                                                </button>
                                                <% if(listing.country) { %>
                                                    <div class="card-location-badge">
                                                        <i class="fa-solid fa-location-dot"></i>
                                                        <%= listing.country %>
                                                    </div>
                                                    <% } %>
                                            </div>
                                            <div class="card-body">
                                                <p class="card-text">
                                                    <b>
                                                        <%= listing.title %>
                                                    </b>
                                                    <span class="price-tag">&#8377; <%=
                                                            listing.price.toLocaleString('en-IN') %></span>
                                                    <span style="color: var(--color-gray-400);"> / night</span>
                                                    <i class="tax-info">&nbsp;&nbsp;+18% GST</i>
                                                </p>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                                <% } %>
                        </div>

                        <% } %>
    </div>

    <script>
        let taxSwitch = document.getElementById("switchCheckDefault");
        taxSwitch.addEventListener("click", () => {
            let taxInfo = document.getElementsByClassName("tax-info");
            for (let i = 0; i < taxInfo.length; i++) {
                if (taxSwitch.checked) {
                    taxInfo[i].style.display = "inline";
                } else {
                    taxInfo[i].style.display = "none";
                }
            }
        });
    </script>