<% if(success && success.length) { %>
    <div class="flash-container">
        <div class="flash-toast flash-success" role="alert">
            <i class="fa-solid fa-circle-check flash-icon"></i>
            <span>
                <%= success %>
            </span>
            <button type="button" class="btn-close btn-close-white btn-sm" data-bs-dismiss="alert"
                aria-label="Close"></button>
        </div>
    </div>
    <% } %>

        <% if(error && error.length) { %>
            <div class="flash-container">
                <div class="flash-toast flash-error" role="alert">
                    <i class="fa-solid fa-triangle-exclamation flash-icon"></i>
                    <span>
                        <%= error %>
                    </span>
                    <button type="button" class="btn-close btn-close-white btn-sm" data-bs-dismiss="alert"
                        aria-label="Close"></button>
                </div>
            </div>
            <% } %>